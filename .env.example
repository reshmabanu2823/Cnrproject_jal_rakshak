# Use with `docker run --env-file .env ...`, or export these in your shell. The app does not read .env by itself. All optional.

# Protects every write/admin endpoint. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
JALRAKSHAK_ADMIN_KEY=

# false in production: no demo seeding, /api/demo/reseed disabled
JALRAKSHAK_DEMO_MODE=true

# SQLite file location (mount a volume here in Docker)
JALRAKSHAK_DB=backend/jalrakshak.db

# Comma-separated origins allowed to call the API from another site (empty = same-origin only)
JALRAKSHAK_CORS_ORIGINS=

JALRAKSHAK_RATE_LIMIT_PER_MIN=120
JALRAKSHAK_DEVICE_RATE_LIMIT_PER_MIN=60
JALRAKSHAK_DEVICE_OFFLINE_MINUTES=30
JALRAKSHAK_ALERT_SCAN_SECONDS=60
JALRAKSHAK_WEBHOOK_TIMEOUT_S=5
JALRAKSHAK_WEBHOOK_MAX_ATTEMPTS=3
JALRAKSHAK_LOG_LEVEL=INFO
